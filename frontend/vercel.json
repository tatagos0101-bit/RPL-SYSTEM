{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rpl-system-api.vercel.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://rpl-system-api.vercel.app/uploads/:path*"
    },
    {
      "source": "/health",
      "destination": "https://rpl-system-api.vercel.app/health"
    },
    {
      "source": "/((?!api(?:/|$)|uploads(?:/|$)|health(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!api(?:/|$)|uploads(?:/|$)|health(?:/|$)).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
