# Backend API base URL. In production replace with your deployed backend domain.
# Example: VITE_API_URL=https://api.library.rizalprovince.gov.ph
VITE_API_URL=http://localhost:8000
# Production: leave unset when using scripts/configure_vercel.py (same-origin /api).
# Every VITE_* value can be included in browser code. Use public configuration only.
# Never put database URLs/passwords, signing secrets, or Supabase privileged keys here.
# This SPA calls FastAPI; it does not require Supabase anon/publishable keys or NEXT_PUBLIC_* aliases.
