{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "installCommand": "npm --prefix frontend ci",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rpl-system-api.vercel.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://rpl-system-api.vercel.app/uploads/:path*"
    },
    {
      "source": "/health",
      "destination": "https://rpl-system-api.vercel.app/health"
    },
    {
      "source": "/((?!api(?:/|$)|uploads(?:/|$)|health(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!api(?:/|$)|uploads(?:/|$)|health(?:/|$)).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src 'self' https://rpl-system-api.vercel.app https://quzhxkgkdrctiosyjxcr.supabase.co https://www.googleapis.com https://openlibrary.org; media-src 'self' blob:; worker-src 'none'; frame-src 'none'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
