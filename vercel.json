{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "installCommand": "npm --prefix frontend ci",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://rpl-system-api.vercel.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://rpl-system-api.vercel.app/uploads/:path*"
    },
    {
      "source": "/health",
      "destination": "https://rpl-system-api.vercel.app/health"
    },
    {
      "source": "/((?!api(?:/|$)|uploads(?:/|$)|health(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
