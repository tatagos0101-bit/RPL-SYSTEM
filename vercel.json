{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "installCommand": "npm --prefix frontend ci",
  "rewrites": [
    { "source": "/((?!api(?:/|$)|uploads(?:/|$)|health(?:/|$)).*)", "destination": "/index.html" }
  ]
}
