# ── Database ──────────────────────────────────────────────────────────────────
# Local development only. Production uses Supabase PostgreSQL (see docs/DEPLOYMENT.md).
# DATABASE_URL takes precedence over the integration's POSTGRES_URL fallback.
# Choose one source of connection settings; never copy production values into local development.
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/rizal_library
# Supabase Dashboard > Connect > Transaction pooler. URL-encode the password.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong random secret (minimum 32 chars):
# This signs application sessions; it is not SUPABASE_JWT_SECRET.
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Shared rate limits: leave blank for isolated local memory limits.
# Provision a Redis service separately; never use production Redis in development.
RATE_LIMIT_STORAGE_URI=
# Production example: rediss://USERNAME:URL_ENCODED_PASSWORD@REDIS_HOST:6379/0
# Enable only with the approved shared service; outage then rejects limited requests.
RATE_LIMIT_REQUIRE_SHARED=false

# ── Business rules ────────────────────────────────────────────────────────────
FINE_PER_DAY=5
LOAN_DAYS=14
PICKUP_WINDOW_HOURS=24

# ── Face recognition ──────────────────────────────────────────────────────────
# auto uses InsightFace/ArcFace when installed, then falls back to dlib.
# Use FACE_ENGINE=dlib if you want the old lightweight behavior only.
FACE_ENGINE=auto
INSIGHTFACE_MODEL_PACK=buffalo_l
FACE_MATCH_THRESHOLD_LOGIN=0.45
FACE_MATCH_THRESHOLD_GATE=0.40
FACE_MATCH_MARGIN=0.08
FACE_AUTO_UPGRADE_EMBEDDINGS=true

# ── Librarian registration ────────────────────────────────────────────────────
# Anyone who knows this code can register as a librarian — keep it secret.
LIBRARIAN_AUTH_CODE=change-this-to-a-secret-code

# ── Deployment ────────────────────────────────────────────────────────────────
# Set to 'production' when deploying. Enables HSTS, disables docs UI,
# disables hot-reload, and makes weak-secret checks fatal.
ENVIRONMENT=development
# Optional local demo seed only; use unique passwords, never commit them.
SEED_LIBRARIAN_PASSWORD=
SEED_MEMBER_PASSWORD=
# Run python migrate.py before releasing production. Railway runs this pre-deploy.
AUTO_MIGRATE=true
# In production use stdout / your hosting platform's logs.
LOG_TO_FILES=true

# Supabase Storage: production requires supabase, never local disk.
STORAGE_BACKEND=local
SUPABASE_URL=
# Server-only service_role JWT or sb_secret key. Never set this in VITE_* variables.
# SUPABASE_SECRET_KEY is not an automatic fallback; this is the name consumed by Storage.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_COVERS_BUCKET=rpl-covers
SUPABASE_AVATARS_BUCKET=rpl-avatars
SUPABASE_IDS_BUCKET=rpl-ids
STORAGE_SIGNED_URL_SECONDS=3600

# Optional bootstrap PIN; librarians can replace it in Settings (6-12 digits).
# In production, missing/1234 disables kiosk access until a librarian sets a PIN.
ENTRY_STATION_PIN=1234
# Use lax with the recommended Vercel /api proxy.
AUTH_COOKIE_SAMESITE=lax

# Set to 'true' once TLS is terminated by your reverse proxy (nginx / Caddy).
# The middleware will redirect HTTP → HTTPS via X-Forwarded-Proto.
HTTPS_ONLY=false

# Comma-separated list of allowed CORS origins.
# In production replace with your actual frontend domain:
#   ALLOWED_ORIGINS=https://library.rizalprovince.gov.ph
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
